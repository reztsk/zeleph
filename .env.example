# Zeleph — variables d'environnement. NE JAMAIS committer le vrai fichier.
# En local : copier ce fichier en `.dev.vars` (lu par `wrangler dev`).
# En production : `npx wrangler secret put NOM` pour les secrets, [vars] de wrangler.toml pour le reste.

# --- E-mails OTP (Brevo) ---
# Secret : clé API Brevo (SMTP & API → Clés API). Jamais côté client.
BREVO_API_KEY=xkeysib-...
# Expéditeur validé dans Brevo (Expéditeurs, domaines & IP dédiées)
BREVO_SENDER_EMAIL=noreply@exemple.fr
BREVO_SENDER_NAME=Zeleph

# --- Dev local uniquement ---
# 1 = le code OTP est renvoyé à l'écran au lieu d'un e-mail. N'agit QUE sur localhost / 127.0.0.1 (ignoré ailleurs).
DEMO_OTP=1

# --- Extracteur audio dédié (optionnel, dossier extractor/) ---
# Utilisé si YouTube bloque l'IP du Worker. URL publique de l'extracteur + jeton partagé (secret des deux côtés).
# EXTRACTOR_URL=https://extracteur.exemple.fr
# EXTRACTOR_TOKEN=une-longue-chaine-aleatoire
