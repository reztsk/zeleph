{
  "name": "zeleph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zeleph : lecteur musical PWA ultra léger (audio YouTube sans pub, playlists, amis) sur Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute zeleph --local --file=worker/schema.sql",
    "db:init:remote": "wrangler d1 execute zeleph --remote --file=worker/schema.sql",
    "icons": "node tools/icons.mjs",
    "check": "node tools/check.mjs",
    "test": "node tools/check.mjs && node --test test/unit.test.mjs test/api.test.mjs",
    "test:live": "node --test test/live.test.mjs",
    "test:extractor": "node --test test/extractor.test.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "deploy": "npm test && node tools/deploy.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
